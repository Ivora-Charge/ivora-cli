{
  "name": "@ivora/cli",
  "version": "0.0.0",
  "description": "Command-line client for the public Ivora /v1 API (pre-alpha)",
  "license": "Apache-2.0",
  "author": "Ivora",
  "private": false,
  "type": "module",
  "bin": {
    "ivora": "dist/bin/ivora.js"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ivora-Charge/ivora-cli.git"
  },
  "homepage": "https://github.com/Ivora-Charge/ivora-cli#readme",
  "bugs": {
    "url": "https://github.com/Ivora-Charge/ivora-cli/issues"
  },
  "keywords": [
    "ivora",
    "ocpp",
    "ev-charging",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/clean.mjs .test-build && tsc -p tsconfig.test.json && node --test --test-reporter=spec \".test-build/test/**/*.test.js\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/guard-publish.mjs"
  },
  "dependencies": {
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
